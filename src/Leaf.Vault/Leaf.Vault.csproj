<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Leaf Vault: a Windows service (NT SERVICE\LeafVault) that holds every Leaf secret and
       never returns one. Control pipe + loopback egress proxy + badge signing. -->
  <PropertyGroup>
    <RootNamespace>Leaf.Vault</RootNamespace>
    <AssemblyName>Leaf.Vault</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No appsettings.json, launchSettings or static web assets: configuration is
         leaf-vault.json beside the executable, written by scripts/install.ps1. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Leaf.Vault.Client\Leaf.Vault.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Leaf.Vault.Tests" />
  </ItemGroup>

  <!-- The vault never runs under IIS: keep the ASP.NET Core IIS module out of the published
       output, so the release is the single Leaf.Vault.exe and nothing beside it. -->
  <Target Name="DropIisModuleFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>

</Project>
